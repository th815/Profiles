#!name=Sub-Store-田昊
#!desc=支持 Surge 正式版的参数设置功能. 测落地功能 ability: http-client-policy, 同步配置的定时 cronexp: 55 23 * * *
#!category=订阅管理
#!arguments=ability:http-client-policy,cronexp:55 23 * * *,sync:"Sub-Store Sync",timeout:900,engine:auto,produce:"# Sub-Store Produce",produce_cronexp:50 */6 * * *,sync_success_notify:true,produce_sub:"sub1,sub2",produce_col:"col1,col2",max_size:-1,cors:"https://sub-store.vercel.app,http://substore.stash,https://substore.stash"
#!arguments-desc=\n1️⃣ ability\n\n默认已开启测落地能力\n需要配合脚本操作\n如 https://raw.githubusercontent.com/Keywos/rule/main/cname.js\n填写任意其他值关闭\n\n2️⃣ cronexp\n\n同步配置定时任务\n默认为每天 23 点 55 分\n\n定时任务指定时将订阅/文件上传到私有 Gist. 在前端, 叫做 '同步' 或 '同步配置'\n\n3️⃣ sync\n\n自定义定时任务名\n便于在脚本编辑器中选择\n若设为 # 可取消定时任务\n\n4️⃣ timeout\n\n脚本超时, 单位为秒\n\n5️⃣ engine\n\n默认为自动使用 webview 引擎, 可设为指定 jsc, 但 jsc 容易爆内存\n\n6️⃣ produce\n\n自定义处理订阅的定时任务名\n一般用于定时处理耗时较长的订阅, 以更新缓存\n这样 Surge 中拉取的时候就能用到缓存, 不至于总是超时\n若设为 # 可取消此定时任务\n默认不开启\n\n7️⃣ produce_cronexp\n\n配置处理订阅的定时任务\n\n默认为每 6 小时\n\n8️⃣ sync_success_notify\n\n同步配置全部成功时是否发送完成通知\n默认为 true, 填 false/0/no/off 可关闭\n\n9️⃣ produce_sub\n\n自定义需定时处理的单条订阅名\n多个用 , 连接\n\n🔟 produce_col\n\n自定义需定时处理的组合订阅名\n多个用 , 连接\n\n1️⃣1️⃣ cors\n\n允许浏览器跨域访问 Sub-Store 后端的 origin. 默认为 https://sub-store.vercel.app,http://substore.stash,https://substore.stash. 多个用 , 连接. 设为 * 可恢复旧的任意来源访问行为, 存在钓鱼网站读取配置的风险\n\n⚠️ 注意: 是 名称(name) 不是 显示名称(displayName)\n如果名称需要编码, 请编码后再用 , 连接\n顺序: 并发执行单条订阅, 然后并发执行组合订阅

# ---------------------------------------------------------------------------
# 本模块相对上游 sub-store-org/Sub-Store 官方版本共 3 处改动, 升级时务必保留:
#
#   1. script-path 由官方 releases 改为本仓库自带的 *.poly.js
#      poly 文件 = textencoder-polyfill.js + 官方同名 bundle(严格拼接, 未改代码)
#      原因: bundle 中存在未加 typeof 守卫的 new TextEncoder() 调用, 部分 Surge
#            脚本引擎不保证提供全局 TextEncoder/TextDecoder, 缺失直接 ReferenceError.
#            polyfill 为「已有则不覆盖」实现, 环境正常时零影响.
#
#   2. engine 由上游的 {{{engine}}}(默认 auto) 改回硬编码 webview
#      这是 2025-09 为适配 Surge 5.7.6 (2838) 所做的改动.
#      依据 Surge 官方手册 (manual.nssurge.com/scripting/overview.html):
#        - engine 参数需要 iOS 5.9.0+ / Mac 5.5.0+ 才支持
#        - auto = 「WebView 可用时就用 WebView」, 不可用时静默回落 JSC
#        - JSC 跑在 iOS NE 进程内, 有内存上限; 官方建议「脚本用到 WebAPI 时
#          必须显式配置 engine=webview」
#      Sub-Store bundle 依赖 WebAPI (fetch / crypto / TextEncoder 等) 且体积已达
#      1.3MB, 一旦 auto 回落到 JSC 会直接崩, Surge 随即跳过脚本走 passthrough,
#      表现为前端连不上后端 (前端版本能显示, 模块版本为空, Network Error).
#      注: #!arguments 里的 engine:auto 仅为与上游保持参数表一致, 脚本行不引用它.
#
#   3. 脚本 URL 带版本号目录 (scripts/2.36.56/), 即不可变 URL (immutable URL)
#      Surge 按 URL 缓存脚本, 且重装模块不会重新拉取同一个 URL. 若沿用固定文件名
#      (如 Sub-Store/sub-store-0.poly.js), 内容更新后 Surge 仍会用旧的缓存副本,
#      表现为「模块已重装但后端版本还是旧的」——2026-09-02 升级到 2.36.56 时踩过:
#      前端显示正常、脚本也在跑, 但 /api/utils/env 一直返回旧版本号 2.20.26.
#      版本进 URL = 每次升级必然是全新 URL, 必然重新拉取, 彻底消除该问题.
#
# 升级: 执行 ./build-poly.sh <新版本号>, 脚本会自动生成 scripts/<版本号>/ 目录、
#       改写本文件的 script-path, 并清理旧版本目录. 无需手动编辑本文件.
# ---------------------------------------------------------------------------

[MITM]
hostname = %APPEND% sub.store

[Script]
Sub-Store Core=type=http-request,pattern=^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))),script-path=https://raw.githubusercontent.com/th815/Profiles/main/Sub-Store/scripts/2.36.56/sub-store-1.poly.js,requires-body=true,timeout={{{timeout}}},ability="{{{ability}}}",engine=webview,max-size={{{max_size}}},argument="cors={{{cors}}}"

Sub-Store Simple=type=http-request,pattern=^https?:\/\/sub\.store,script-path=https://raw.githubusercontent.com/th815/Profiles/main/Sub-Store/scripts/2.36.56/sub-store-0.poly.js,requires-body=true,timeout={{{timeout}}},engine=webview,max-size={{{max_size}}},argument="cors={{{cors}}}"

{{{sync}}}=type=cron,cronexp="{{{cronexp}}}",wake-system=1,timeout={{{timeout}}},script-path=https://raw.githubusercontent.com/th815/Profiles/main/Sub-Store/scripts/2.36.56/cron-sync-artifacts.poly.js,engine=webview,argument="sync_success_notify={{{sync_success_notify}}}"

{{{produce}}}=type=cron,cronexp="{{{produce_cronexp}}}",wake-system=1,timeout={{{timeout}}},script-path=https://raw.githubusercontent.com/th815/Profiles/main/Sub-Store/scripts/2.36.56/cron-sync-artifacts.poly.js,engine=webview,argument="sub={{{produce_sub}}}&col={{{produce_col}}}"
